# The database. SQLite locally; Postgres in production, either as a URL
# (DATABASE_URL or DB_URL, e.g. postgres://user:password@host:5432/db?sslmode=require)
# or as Laravel's separate variables (DB_CONNECTION=pgsql, DB_HOST, DB_PORT, DB_DATABASE,
# DB_USERNAME, DB_PASSWORD, DB_SSLMODE).
DATABASE_URL=sqlite:database/database.sqlite

# Encrypts the session cookies. Laravel's APP_KEY (base64:…) works as is; generate one with
# `openssl rand -base64 32` and prefix it with `base64:`. Without it, logins end on every restart.
APP_KEY=

# The port to listen on. Laravel Cloud sets this itself.
PORT=3000

# Where uploaded images go: `public` (the storage/app/public folder) or `s3` (a bucket, with the
# AWS_* variables below; Laravel Cloud fills them in when a bucket is attached).
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# How much to log: e.g. `adrijanzivkov=debug,tower_http=debug`.
RUST_LOG=adrijanzivkov=info,tower_http=info
