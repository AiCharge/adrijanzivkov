{
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.8.0",
    "engines": {
        "node": ">=24",
        "pnpm": ">=11"
    },
    "scripts": {
        "build": "pnpm run build:site && pnpm run build:admin && pnpm run build:editor",
        "build:site": "tailwindcss --input assets/css/app.css --output public/css/app.css --minify",
        "build:admin": "tailwindcss --input assets/css/admin.css --output public/css/admin.css --minify",
        "build:editor": "esbuild assets/js/editor.js --bundle --minify --format=esm --target=es2022 --outfile=public/js/editor.js",
        "dev": "tailwindcss --input assets/css/app.css --output public/css/app.css --watch"
    },
    "devDependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@tailwindcss/cli": "^4.3.5",
        "@tiptap/core": "^3.35.0",
        "@tiptap/extension-image": "^3.35.0",
        "@tiptap/extension-text-align": "^3.35.0",
        "@tiptap/pm": "^3.35.0",
        "@tiptap/starter-kit": "^3.35.0",
        "esbuild": "^0.28.2",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0"
    }
}
